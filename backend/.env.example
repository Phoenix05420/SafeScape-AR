# Default zero-config SQLite database (works out of the box)
DATABASE_URL=sqlite+aiosqlite:///./safescape.db

# Optional: To use PostgreSQL in production, uncomment the line below:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/safescape

SECRET_KEY=supersecretkey_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
